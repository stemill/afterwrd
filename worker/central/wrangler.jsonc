// afterwrd's installer at https://install.afterwrd.app (central/index.js). Deployed by hand from worker/:
//   npx wrangler deploy -c central/wrangler.jsonc
// It has no storage, secrets or bindings, and nothing is logged.
{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "afterwrd-install",
	"main": "index.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [{ "pattern": "install.afterwrd.app", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": false },
	"logpush": false
}
