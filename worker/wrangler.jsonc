{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "afterwrd",
	"main": "src/index.js",
	// Records each static file's hash for the code to check (scripts/asset-hashes.mjs, src/static.js); runs before
	// every build, and again when public/ changes under `wrangler dev`.
	"build": {
		"command": "node scripts/asset-hashes.mjs",
		"watch_dir": ["src", "public"]
	},
	"compatibility_date": "2026-10-01",
	// global_fetch_strictly_public: calls to a friend's site go out over the internet even when it's in the same
	// Cloudflare account (otherwise Cloudflare answers 404), so two people sharing an account can connect.
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	// The site's own files: stylesheet, import page scripts. The archive itself lives in D1 (pages) and the
	// MEDIA Durable Objects (photos and videos), so deploying code never touches it.
	// run_worker_first sends every request through the login check, and the Worker picks exact files itself,
	// so Cloudflare's own HTML and 404 handling is off.
	"assets": {
		"directory": "public",
		"binding": "ASSETS",
		"run_worker_first": true,
		"html_handling": "none",
		"not_found_handling": "none"
	},
	// Migration files are bundled as text: the Worker applies them itself (src/migrate.js).
	"rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
	// Photos and videos, stored by hash in SQLite-backed Durable Objects (src/media.js), and notes waiting to go to
	// friends' sites (src/outbox.js).
	"durable_objects": {
		"bindings": [{ "name": "MEDIA", "class_name": "MediaStore" }, { "name": "OUTBOX", "class_name": "Outbox" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["MediaStore", "Outbox"] }],
	// Found by name, or created on first deploy. (The installer creates its own, named after the Worker.)
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "afterwrd",
			"migrations_dir": "migrations"
		}
	]
}